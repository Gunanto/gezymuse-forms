# Contoh environment untuk GezyForm — salin menjadi .env di VPS
# (JANGAN commit file .env asli ke Git!)

# Port HTTP aplikasi (default 3022)
PORT=3022

# Folder database SQLite (default ./data)
DATA_DIR=/opt/gezyform/data

# Password akun admin pertama (hanya dipakai saat DB masih kosong).
# Kalau dikosongkan, password acak dibuat & ditampilkan sekali di log.
ADMIN_PASSWORD=ganti-dengan-password-yang-kuat

# 1 = cookie sesi hanya via HTTPS (wajib 1 di produksi di belakang nginx+TLS)
# 0 = boleh via HTTP (pengembangan lokal)
COOKIE_SECURE=1
